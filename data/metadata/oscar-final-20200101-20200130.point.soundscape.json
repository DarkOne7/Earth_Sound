{
  "sonification_version": "1.0.0",
  "determinism": "No randomness is used. Identical ProcessedCurrentSeries content and identical SonificationSettings give byte-identical WAV bytes and provenance on the same platform and NumPy build (tested). Across platforms, floating-point libm differences may change isolated PCM samples by at most 1 LSB; two renders are considered equivalent when their provenance (excluding output.sha256) is identical and every PCM sample differs by at most 1 LSB.",
  "settings": {
    "duration_seconds": 30.0,
    "sample_rate_hz": 44100,
    "channels": 2,
    "bit_depth": 16,
    "carrier_frequency_hz": 220.0,
    "harmonic_amplitudes": [
      1.0,
      0.5,
      0.25
    ],
    "gain_floor_db": -36.0,
    "peak_amplitude": 0.9,
    "attack_seconds": 0.01,
    "release_seconds": 0.05,
    "direction_mapping": "stereo_pan_east_west"
  },
  "mappings": [
    {
      "sound_parameter": "segment timing (rhythm)",
      "source_measurement": "sample order and count of the processed series (one sample per file time step)",
      "rule": "duration_seconds is split into len(samples) equal segments in series order; segment i covers frames [round(i*F/n), round((i+1)*F/n)) with F = round(duration*sample_rate). Each audible segment is shaped by a linear attack and release envelope, so each sample is one pulse.",
      "rationale": "Temporal change is heard as a sequence of pulses that follows the measured time axis."
    },
    {
      "sound_parameter": "loudness (gain)",
      "source_measurement": "speed_normalized in [0, 1] (speed against the documented 0-2.5 m s-1 range)",
      "rule": "gain_db = gain_floor_db * (1 - speed_normalized); amplitude = peak_amplitude * 10**(gain_db/20). speed_normalized = 0 gives gain_floor_db (default -36 dB), 1 gives 0 dB. Clipped speeds already carry speed_normalized = 1 (flag clipped_high) and sound at 0 dB.",
      "rationale": "Perceived loudness grows roughly with the logarithm of amplitude, so equal steps in normalized speed give roughly equal loudness steps. Zero speed stays audible so it is distinguishable from silence, which means no data."
    },
    {
      "sound_parameter": "silence",
      "source_measurement": "sample status",
      "rule": "status missing or invalid renders digital silence for the whole segment (all PCM samples 0).",
      "rationale": "A gap in the data must not be heard as a measurement, so it is not heard at all."
    },
    {
      "sound_parameter": "stereo position (pan)",
      "source_measurement": "direction_deg (direction the current flows toward, clockwise from north)",
      "rule": "pan = sin(radians(direction_deg)) in [-1, 1]; 90 (eastward) = +1 = right, 270 (westward) = -1 = left, 0 and 180 (northward, southward) = 0 = centre. Undefined direction = centre. Constant-power law: angle = (pan + 1)/2 * pi/2, left = cos(angle), right = sin(angle). Disabled when direction_mapping = 'none' (all centred).",
      "rationale": "Direction is circular; mapping it to a linear parameter such as pitch would put a discontinuity at north. The east-west component maps continuously to left-right. The north-south component is NOT rendered: northward and southward flow sound the same (documented MVP limitation)."
    },
    {
      "sound_parameter": "pitch and timbre",
      "source_measurement": "none (constant)",
      "rule": "Fixed carrier at carrier_frequency_hz with harmonics 1..n at harmonic_amplitudes, normalized by their sum so the waveform peak never exceeds 1 before gain. Phase is continuous across the whole file.",
      "rationale": "Nothing is mapped to pitch, so pitch must not vary and suggest a measurement that does not exist."
    }
  ],
  "omitted_mappings": [
    {
      "sound_parameter": "pitch or timbre from temperature",
      "source_measurement": "sea-surface temperature (not available)",
      "rule": "Not rendered.",
      "rationale": "Phase 2 verified at file level (2026-11-14) that OSCAR v2.0 Final granules contain only u, v, ug, vg, lat, lon and time; SST appears only as an input in the 'source' attribute. See docs/ocean-dataset-decision.md."
    },
    {
      "sound_parameter": "north-south component of direction",
      "source_measurement": "cos(direction_deg)",
      "rule": "Not rendered.",
      "rationale": "No single clear, testable audio dimension was identified for a second circular component in the MVP. Candidate for a later phase (e.g. brightness/filter cutoff), to be validated in Phase 6 listening tests."
    }
  ],
