{
  "sonification_version": "2.0.0",
  "determinism": "No randomness is used. Identical series content and identical SonificationSettings give byte-identical WAV bytes and provenance on the same platform and NumPy build (tested). Across platforms, floating-point libm differences may change isolated PCM samples by at most 1 LSB; two renders are considered equivalent when their provenance (excluding output.sha256) is identical and every PCM sample differs by at most 1 LSB.",
  "settings": {
    "duration_seconds": 30.0,
    "sample_rate_hz": 44100,
    "channels": 2,
    "bit_depth": 16,
    "carrier_frequency_hz": 220.0,
    "harmonic_amplitudes": [
      1.0,
      0.5,
      0.25
    ],
    "gain_floor_db": -36.0,
    "peak_amplitude": 0.9,
    "attack_seconds": 0.01,
    "release_seconds": 0.05,
    "pan_enabled": true,
    "timing_mode": "rate_weighted",
    "rate_sensitivity": 1.5
  },
  "engine_mappings": [
    {
      "sound_parameter": "segment order (which pulse is which sample)",
      "source_measurement": "sample order of the validated series",
      "rule": "The samples are rendered in series order, one segment each, covering the whole duration with no overlap and no gap. Each audible segment is shaped by a linear attack and release envelope, so each sample is one pulse. Every segment records its own timestamp, start_seconds and end_seconds, so the mapping from audio time to data time is always exact.",
      "rationale": "Temporal change is heard as a sequence of pulses that follows the measured time axis."
    },
    {
      "sound_parameter": "segment length (pulse rate / rhythm)",
      "source_measurement": "rate_normalized in [0, 1], the normalized rate of change derived and documented by the data domain; unused under timing_mode='uniform'",
      "rule": "timing_mode='uniform': every sample gets an equal share of the duration. timing_mode='rate_weighted' (default): a sample's share is proportional to 1 / (1 + rate_sensitivity * rate_normalized), so rapid change gives short segments and a fast pulse, calm stretches give long segments and a slow pulse. The total duration is unchanged; only its distribution moves. Boundaries are computed in exact rational arithmetic. provenance.timing records the mode, the mean and fastest pulse rates, whether the fastest stretch stays below the 20 Hz rhythm floor, and whether the time axis is linear.",
      "rationale": "A uniform pulse makes a long calm stretch and a sudden surge sound equally eventful. Letting the rate of change set the pulse rate means acceleration is heard as acceleration, which is the quantity a listener registers most immediately. The cost is that audio time is no longer proportional to elapsed data time, so linear_time_axis is recorded as false and each segment carries its own timestamp for the exact mapping."
    },
    {
      "sound_parameter": "loudness (gain)",
      "source_measurement": "level_normalized in [0, 1], derived and documented by the data domain",
      "rule": "gain_db = gain_floor_db * (1 - level_normalized); amplitude = peak_amplitude * 10**(gain_db/20). level_normalized = 0 gives gain_floor_db (default -36 dB), 1 gives 0 dB.",
      "rationale": "Perceived loudness grows roughly with the logarithm of amplitude, so equal steps in the normalized level give roughly equal loudness steps. A level of 0 stays audible so that a measured minimum is distinguishable from silence, which means absent data."
    },
    {
      "sound_parameter": "silence",
      "source_measurement": "the domain's audibility decision for each sample",
      "rule": "A sample the domain marked inaudible renders digital silence for its whole segment (all PCM samples 0).",
      "rationale": "A gap in the data must not be heard as a measurement, so it is not heard at all."
    },
    {
      "sound_parameter": "stereo position (pan)",
      "source_measurement": "pan in [-1, 1], derived and documented by the data domain",
      "rule": "Constant-power law: angle = (pan + 1)/2 * pi/2, left = cos(angle), right = sin(angle), so left**2 + right**2 = 1 at every position. pan = None (unmapped or undefined) is centred. Disabled when pan_enabled is false, which centres every segment.",
      "rationale": "Stereo position is a continuous dimension with no discontinuity, so it carries a second variable without disturbing the loudness that encodes the first."
    },
    {
      "sound_parameter": "pitch and timbre",
      "source_measurement": "none (constant)",
      "rule": "Fixed carrier at carrier_frequency_hz with harmonics 1..n at harmonic_amplitudes, normalized by their sum so the waveform peak never exceeds 1 before gain. Phase is continuous across the whole file.",
      "rationale": "No domain maps a measurement to pitch, so pitch must not vary and imply a measurement that does not exist."
    }
  ],
  "domain_mappings": [
    {
      "sound_parameter": "level_normalized (-> loudness)",
      "source_measurement": "current speed in m s-1, normalized against 0-2.5 m s-1 (Phase 3 speed_normalized)",
      "rule": "level_normalized = speed_normalized, used unchanged. Speeds above the reference maximum were already clipped to 1.0 by Phase 3 and carry the clipped_high flag.",
      "rationale": "Speed is the primary quantity a listener should feel. Its reference range is global, not per-sample, so loudness is comparable between regions."
    },
    {
      "sound_parameter": "pan (-> stereo position)",
      "source_measurement": "direction_deg, the direction the current flows toward, clockwise from true north",
      "rule": "pan = sin(radians(direction_deg)), the east-west component. 90 (eastward) = +1 = right, 270 (westward) = -1 = left, 0 and 180 (northward, southward) = 0 = centre. Values below 1e-12 are snapped to 0. Undefined direction (zero speed) = centre.",
      "rationale": "Direction is circular, so mapping it to a linear parameter such as pitch would put a discontinuity at north and make 359 and 1 degrees sound maximally different although they are nearly the same flow. The east-west component maps continuously to left-right."
    },
    {
      "sound_parameter": "rate_normalized (-> pulse rate)",
      "source_measurement": "change in normalized speed since the previous usable sample",
      "rule": "rate_normalized = min(1, |speed_normalized - previous speed_normalized| / 0.25). A change of a quarter of the full 0-2.5 m s-1 scale in one step (0.625 m s-1) gives the fastest pulse. The first usable sample and any sample following a gap have no previous value, so their rate is unknown and treated as 0 (slowest).",
      "rationale": "A difference of two already-cited normalized speeds needs no further reference of its own. The 0.25 full scale is a product choice: daily surface-current changes are small, so a full scale of 1.0 would leave the pulse almost constant."
    },
    {
      "sound_parameter": "audibility",
      "source_measurement": "Phase 3 sample status",
      "rule": "valid and undefined_direction are audible; missing and invalid are silent. A measured zero speed therefore still sounds, at the gain floor.",
      "rationale": "Absent or rejected measurements must not be rendered as a current of zero speed."
    }
  ],
  "omitted_mappings": [
    {
      "sound_parameter": "pitch or timbre from temperature",
      "source_measurement": "sea-surface temperature (not available)",
      "rule": "Not rendered.",
      "rationale": "Phase 2 verified at file level (2026-11-14) that OSCAR v2.0 Final granules contain only u, v, ug, vg, lat, lon and time; SST appears only as an input in the 'source' attribute. See docs/ocean-dataset-decision.md."
    },
    {
      "sound_parameter": "north-south component of direction",
      "source_measurement": "cos(direction_deg)",
      "rule": "Not rendered.",
      "rationale": "No single clear, testable audio dimension was identified for a second circular component in the MVP, so northward and southward flow sound the same. Candidate for a later phase (e.g. brightness/filter cutoff), to be validated in Phase 6 listening tests."
    }
  ],
